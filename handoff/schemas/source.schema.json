{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Source",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^SRC-\\d{3}$"
  },
  "title": {
   "type": "string"
  },
  "url": {
   "type": "string",
   "format": "uri"
  },
  "grade": {
   "type": "string"
  },
  "supports": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "verify": {
   "type": "boolean"
  }
 },
 "required": [
  "id",
  "title",
  "url",
  "grade"
 ],
 "additionalProperties": true
}